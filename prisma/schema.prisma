enum OtpTransport {
  Email  @map("email")
  Mobile @map("mobile")

  @@map("otp_transport")
}

model Otp {
  code             String
  attempt          Int          @default(1) @db.SmallInt
  lastSentAt       DateTime     @default(now()) @map("last_sent_at")
  retries          Int          @default(0) @db.SmallInt
  transport        OtpTransport
  target           String
  lastCodeVerified Boolean      @default(false) @map("last_code_verified")
  blocked          Boolean      @default(false)

  @@unique([transport, target])
  @@map("otp")
}

enum SettingType {
  Binary       @map("binary")
  MultiSelect  @map("multi_select")
  SingleSelect @map("single_select")

  @@map("setting_type")
}

enum SettingContext {
  User   @map("user")
  System @map("System")

  @@map("setting_context")
}

model Setting {
  id               Int             @id @default(autoincrement())
  mappedTo         String          @map("mapped_to")
  text             String          @default("")
  description      String          @default("")
  type             SettingType
  context          SettingContext
  default          Json
  isDefinedOptions Boolean         @map("is_defined_options")
  subSettings      Setting[]       @relation("SubSettings")
  dependsOn        Setting?        @relation("SubSettings", fields: [parentId], references: [id])
  parentId         Int?            @map("parent_id")
  options          SettingOption[]
  userSettings     UserSetting[]
  systemSettings   SystemSetting[]

  @@unique([context, mappedTo])
  @@map("setting")
}

model SettingOption {
  id        Int     @id @default(autoincrement())
  text      String  @default("")
  value     String
  setting   Setting @relation(fields: [settingId], references: [id])
  settingId Int     @map("setting_id")

  @@unique([settingId, value])
  @@map("setting_option")
}

model UserSetting {
  selection Json
  user      User    @relation(fields: [userId], references: [id])
  userId    Int     @map("user_id")
  setting   Setting @relation(fields: [settingId], references: [id])
  settingId Int     @map("setting_id")

  @@id([userId, settingId])
  @@map("user_setting")
}

model SystemSetting {
  selection Json
  setting   Setting @relation(fields: [settingId], references: [id])
  settingId Int     @map("setting_id")

  @@id([settingId])
  @@map("system_setting")
}

// ─── Jagrut Malwa: RBAC ───────────────────────────────────────────────────────

enum RoleType {
  System @map("system")
  Custom @map("custom")

  @@map("role_type")
}

enum RoleStatus {
  Active   @map("active")
  InActive @map("inactive")

  @@map("role_status")
}

model Role {
  id          Int             @id @default(autoincrement())
  name        String          @unique
  description String          @default("")
  type        RoleType        @default(Custom)
  status      RoleStatus      @default(Active)
  isProtected Boolean         @default(false) @map("is_protected")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  privileges  RolePrivilege[]
  admins      Admin[]

  @@map("role")
}

model Privilege {
  id          Int             @id @default(autoincrement())
  key         String          @unique
  module      String
  action      String
  description String          @default("")
  createdAt   DateTime        @default(now()) @map("created_at")
  roles       RolePrivilege[]

  @@map("privilege")
}

model RolePrivilege {
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId      Int       @map("role_id")
  privilege   Privilege @relation(fields: [privilegeId], references: [id], onDelete: Cascade)
  privilegeId Int       @map("privilege_id")

  @@id([roleId, privilegeId])
  @@map("role_privilege")
}

// ─── Jagrut Malwa: Organization Hierarchy ────────────────────────────────────

enum HierarchyLevel {
  Prant  @map("prant")
  Vibhag @map("vibhag")
  Jila   @map("jila")
  Khand  @map("khand_nagar")
  Mandal @map("mandal_basti")
  Gram   @map("gram_mohalla")

  @@map("hierarchy_level")
}

enum HierarchyStatus {
  Active   @map("active")
  InActive @map("inactive")

  @@map("hierarchy_status")
}

model HierarchyNode {
  id                     Int                        @id @default(autoincrement())
  name                   String
  level                  HierarchyLevel
  status                 HierarchyStatus            @default(Active)
  description            String                     @default("")
  parent                 HierarchyNode?             @relation("HierarchyTree", fields: [parentId], references: [id], onDelete: Restrict)
  parentId               Int?                       @map("parent_id")
  children               HierarchyNode[]            @relation("HierarchyTree")
  dispatchesFrom         DispatchEntry[]            @relation("DispatchesFrom")
  dispatchesTo           DispatchEntry[]            @relation("DispatchesTo")
  designationAssignments UserHierarchyDesignation[]
  usersVibhag            User[]                     @relation("UserVibhag")
  usersJila              User[]                     @relation("UserJila")
  usersKhand             User[]                     @relation("UserKhand")
  usersMandal            User[]                     @relation("UserMandal")
  usersGram              User[]                     @relation("UserGram")
  createdAt              DateTime                   @default(now()) @map("created_at")
  updatedAt              DateTime                   @updatedAt @map("updated_at")

  @@unique([parentId, name])
  @@index([level])
  @@index([parentId])
  @@map("hierarchy_node")
}

// ─── Jagrut Malwa: Designation Module ─────────────────────────────────────────

model UserHierarchyDesignation {
  id            Int                  @id @default(autoincrement())
  user          Admin                @relation("UserAssignments", fields: [userId], references: [id], onDelete: Restrict)
  userId        Int                  @map("user_id")
  node          HierarchyNode        @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  nodeId        Int                  @map("node_id")
  designation   HierarchyDesignation @relation(fields: [designationId], references: [id], onDelete: Restrict)
  designationId Int                  @map("designation_id")
  reportingTo   Admin?               @relation("ReportingManager", fields: [reportingId], references: [id], onDelete: SetNull)
  reportingId   Int?                 @map("reporting_id")
  assignedAt    DateTime             @default(now()) @map("assigned_at")
  unassignedAt  DateTime?            @map("unassigned_at")
  isActive      Boolean              @default(true) @map("is_active")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  @@index([userId])
  @@index([nodeId])
  @@index([designationId])
  @@index([reportingId])
  @@index([isActive])
  @@index([nodeId, designationId, isActive])
  @@map("user_hierarchy_designation")
}

// ─── Jagrut Malwa: Publish Issue Module ───────────────────────────────────────

enum PublishIssueStatus {
  Draft     @map("draft")
  Published @map("published")
  Archived  @map("archived")

  @@map("publish_issue_status")
}

model PublishIssue {
  id            Int                @id @default(autoincrement())
  issueNo       String             @unique @map("issue_no")
  title         String             @default("")
  publishDate   DateTime           @map("publish_date")
  totalCopies   Int                @map("total_copies")
  filePath      String?            @map("file_path")
  status        PublishIssueStatus @default(Draft)
  publishedBy   Admin?             @relation("PublishedIssues", fields: [publishedById], references: [id], onDelete: SetNull)
  publishedById Int?               @map("published_by_id")
  dispatches    DispatchEntry[]
  deliveryLogs  DeliveryLog[]
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  @@index([status])
  @@index([publishDate])
  @@index([publishedById])
  @@map("publish_issue")
}

// ─── Jagrut Malwa: Dispatch Module ────────────────────────────────────────────

enum DispatchStatus {
  Draft       @map("draft")
  Dispatched  @map("dispatched")
  InTransit   @map("in_transit")
  Received    @map("received")
  Discrepancy @map("discrepancy")
  Forwarded   @map("forwarded")
  Completed   @map("completed")
  Cancelled   @map("cancelled")

  @@map("dispatch_status")
}

enum DeliveryMethod {
  Courier @map("courier")
  Manual  @map("manual")

  @@map("delivery_method")
}

model DispatchEntry {
  id               Int            @id @default(autoincrement())
  issue            PublishIssue   @relation(fields: [issueId], references: [id], onDelete: Restrict)
  issueId          Int            @map("issue_id")
  fromPoint        HierarchyNode? @relation("DispatchesFrom", fields: [fromPointId], references: [id], onDelete: Restrict)
  fromPointId      Int?           @map("from_point_id")
  toPoint          HierarchyNode  @relation("DispatchesTo", fields: [toPointId], references: [id], onDelete: Restrict)
  toPointId        Int            @map("to_point_id")
  quantity         Int
  dispatchDate     DateTime       @default(now()) @map("dispatch_date")
  trackingLink     String?        @map("tracking_link")
  status           DispatchStatus @default(Dispatched)
  deliveryMethod   DeliveryMethod @default(Manual) @map("delivery_method")
  receivedQuantity Int?           @map("received_quantity")
  receivedAt       DateTime?      @map("received_at")
  receivedBy       Admin?         @relation("DispatchesReceived", fields: [receivedById], references: [id], onDelete: Restrict)
  receivedById     Int?           @map("received_by_id")
  dispatchedBy     Admin?         @relation("DispatchesCreated", fields: [dispatchedById], references: [id], onDelete: Restrict)
  dispatchedById   Int?           @map("dispatched_by_id")
  deliveryLogs     DeliveryLog[]
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@index([issueId])
  @@index([fromPointId])
  @@index([toPointId])
  @@index([status])
  @@index([deliveryMethod])
  @@index([dispatchDate])
  @@index([receivedById])
  @@index([dispatchedById])
  @@map("dispatch_entry")
}

// ─── Jagrut Malwa: Delivery Log Module ────────────────────────────────────────

enum DeliveryLogStatus {
  Pending   @map("pending")
  Delivered @map("delivered")
  Failed    @map("failed")

  @@map("delivery_log_status")
}

model DeliveryLog {
  id              Int               @id @default(autoincrement())
  dispatchEntry   DispatchEntry     @relation(fields: [dispatchEntryId], references: [id], onDelete: Restrict)
  dispatchEntryId Int               @map("dispatch_entry_id")
  issue           PublishIssue      @relation(fields: [issueId], references: [id], onDelete: Restrict)
  issueId         Int               @map("issue_id")
  user            User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId          Int               @map("user_id")
  status          DeliveryLogStatus @default(Pending)
  deliveredAt     DateTime?         @map("delivered_at")
  deliveredBy     Admin?            @relation("DeliveryLogsDelivered", fields: [deliveredById], references: [id], onDelete: SetNull)
  deliveredById   Int?              @map("delivered_by_id")
  remarks         String            @default("")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@unique([dispatchEntryId, userId])
  @@index([dispatchEntryId])
  @@index([dispatchEntryId, status])
  @@index([issueId])
  @@index([userId])
  @@index([status])
  @@map("delivery_log")
}

// ─── Jagrut Malwa: Subscription Module ────────────────────────────────────────

enum PaymentMode {
  UPI          @map("upi")
  Cash         @map("cash")
  Cheque       @map("cheque")
  BankTransfer @map("bank_transfer")
  Card         @map("card")

  @@map("payment_mode")
}

enum SubscriptionPlan {
  Monthly @map("monthly")
  Yearly  @map("yearly")

  @@map("subscription_plan")
}

model Subscription {
  id          Int              @id @default(autoincrement())
  plan        SubscriptionPlan
  startDate   DateTime         @map("start_date")
  endDate     DateTime         @map("end_date")
  utrNumber   String?          @map("utr_number")
  paymentMode PaymentMode      @map("payment_mode")
  remarks     String           @default("")
  externalId  Int? // third party mapping id
  isActive    Boolean          @default(false) @map("is_active")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  user   User @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId Int  @map("user_id")

  @@index([userId])
  @@index([isActive])
  @@index([endDate])
  @@index([userId, isActive])
  @@map("subscription")
}
