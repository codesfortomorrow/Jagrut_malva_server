// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

enum AdminStatus {
  Active @map("active")

  @@map("admin_status")
}

model HierarchyDesignation {
  id          Int                        @id @default(autoincrement())
  name        String
  level       HierarchyLevel
  status      HierarchyStatus            @default(Active)
  description String                     @default("")
  assignments UserHierarchyDesignation[]
  createdAt   DateTime                   @default(now()) @map("created_at")
  updatedAt   DateTime                   @updatedAt @map("updated_at")

  @@unique([level, name])
  @@index([level])
  @@index([status])
  @@map("hierarchy_designation")
}

model Admin {
  id                     Int                        @id @default(autoincrement())
  firstname              String
  lastname               String
  email                  String                     @unique
  mobile                 String?                    @unique
  profileImage           String?                    @map("profile_image")
  status                 AdminStatus                @default(Active)
  createdAt              DateTime                   @default(now()) @map("created_at")
  updatedAt              DateTime                   @updatedAt @map("updated_at")
  meta                   AdminMeta?
  role                   Role                       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  roleId                 Int                        @map("role_id")
  receivedDispatches     DispatchEntry[]            @relation("DispatchesReceived")
  createdDispatches      DispatchEntry[]            @relation("DispatchesCreated")
  designationAssignments UserHierarchyDesignation[] @relation("UserAssignments")
  subordinateAssignments UserHierarchyDesignation[] @relation("ReportingManager")
  publishedIssues        PublishIssue[]             @relation("PublishedIssues")

  @@map("admin")
}

model AdminMeta {
  passwordSalt String? @map("password_salt")
  passwordHash String? @map("password_hash")
  admin        Admin   @relation(fields: [adminId], references: [id])
  adminId      Int     @unique() @map("admin_id")

  @@map("admin_meta")
}

enum UserStatus {
  Active  @map("active")
  Blocked @map("blocked")

  @@map("user_status")
}

model User {
  id                  Int           @id @default(autoincrement())
  firstname           String
  lastname            String
  username            String?       @unique
  email               String        @unique
  dialCode            String?       @map("dial_code")
  mobile              String?       @unique
  profileImage        String?       @map("profile_image")
  isVerified          Boolean       @default(false) @map("is_verified")
  country             String?
  status              UserStatus    @default(Active)
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  meta                UserMeta?
  settings            UserSetting[]
  registeredConsumers Consumer[]    @relation("RegisteredConsumers")

  @@map("user")
}

model UserMeta {
  googleId     String? @unique @map("google_id")
  passwordSalt String? @map("password_salt")
  passwordHash String? @map("password_hash")
  user         User    @relation(fields: [userId], references: [id])
  userId       Int     @unique() @map("user_id")

  @@map("user_meta")
}

enum OtpTransport {
  Email  @map("email")
  Mobile @map("mobile")

  @@map("otp_transport")
}

model Otp {
  code             String
  attempt          Int          @default(1) @db.SmallInt
  lastSentAt       DateTime     @default(now()) @map("last_sent_at")
  retries          Int          @default(0) @db.SmallInt
  transport        OtpTransport
  target           String
  lastCodeVerified Boolean      @default(false) @map("last_code_verified")
  blocked          Boolean      @default(false)

  @@unique([transport, target])
  @@map("otp")
}

enum SettingType {
  Binary       @map("binary")
  MultiSelect  @map("multi_select")
  SingleSelect @map("single_select")

  @@map("setting_type")
}

enum SettingContext {
  User   @map("user")
  System @map("System")

  @@map("setting_context")
}

model Setting {
  id               Int             @id @default(autoincrement())
  mappedTo         String          @map("mapped_to")
  text             String          @default("")
  description      String          @default("")
  type             SettingType
  context          SettingContext
  default          Json
  isDefinedOptions Boolean         @map("is_defined_options")
  subSettings      Setting[]       @relation("SubSettings")
  dependsOn        Setting?        @relation("SubSettings", fields: [parentId], references: [id])
  parentId         Int?            @map("parent_id")
  options          SettingOption[]
  userSettings     UserSetting[]
  systemSettings   SystemSetting[]

  @@unique([context, mappedTo])
  @@map("setting")
}

model SettingOption {
  id        Int     @id @default(autoincrement())
  text      String  @default("")
  value     String
  setting   Setting @relation(fields: [settingId], references: [id])
  settingId Int     @map("setting_id")

  @@unique([settingId, value])
  @@map("setting_option")
}

model UserSetting {
  selection Json
  user      User    @relation(fields: [userId], references: [id])
  userId    Int     @map("user_id")
  setting   Setting @relation(fields: [settingId], references: [id])
  settingId Int     @map("setting_id")

  @@id([userId, settingId])
  @@map("user_setting")
}

model SystemSetting {
  selection Json
  setting   Setting @relation(fields: [settingId], references: [id])
  settingId Int     @map("setting_id")

  @@id([settingId])
  @@map("system_setting")
}

// ─── Jagrut Malwa: RBAC ───────────────────────────────────────────────────────

enum RoleType {
  System @map("system")
  Custom @map("custom")

  @@map("role_type")
}

enum RoleStatus {
  Active   @map("active")
  InActive @map("inactive")

  @@map("role_status")
}

model Role {
  id          Int             @id @default(autoincrement())
  name        String          @unique
  description String          @default("")
  type        RoleType        @default(Custom)
  status      RoleStatus      @default(Active)
  isProtected Boolean         @default(false) @map("is_protected")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  privileges  RolePrivilege[]
  admins      Admin[]

  @@map("role")
}

model Privilege {
  id          Int             @id @default(autoincrement())
  key         String          @unique
  module      String
  action      String
  description String          @default("")
  createdAt   DateTime        @default(now()) @map("created_at")
  roles       RolePrivilege[]

  @@map("privilege")
}

model RolePrivilege {
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId      Int       @map("role_id")
  privilege   Privilege @relation(fields: [privilegeId], references: [id], onDelete: Cascade)
  privilegeId Int       @map("privilege_id")

  @@id([roleId, privilegeId])
  @@map("role_privilege")
}

// ─── Jagrut Malwa: Organization Hierarchy ────────────────────────────────────

enum HierarchyLevel {
  Prant  @map("prant")
  Vibhag @map("vibhag")
  Jila   @map("jila")
  Khand  @map("khand_nagar")
  Mandal @map("mandal_basti")
  Gram   @map("gram_mohalla")

  @@map("hierarchy_level")
}

enum HierarchyStatus {
  Active   @map("active")
  InActive @map("inactive")

  @@map("hierarchy_status")
}

model HierarchyNode {
  id                     Int                        @id @default(autoincrement())
  name                   String
  level                  HierarchyLevel
  status                 HierarchyStatus            @default(Active)
  description            String                     @default("")
  parent                 HierarchyNode?             @relation("HierarchyTree", fields: [parentId], references: [id], onDelete: Restrict)
  parentId               Int?                       @map("parent_id")
  children               HierarchyNode[]            @relation("HierarchyTree")
  dispatchesFrom         DispatchEntry[]            @relation("DispatchesFrom")
  dispatchesTo           DispatchEntry[]            @relation("DispatchesTo")
  designationAssignments UserHierarchyDesignation[]
  consumersJila          Consumer[]                 @relation("ConsumerJila")
  consumersKhand         Consumer[]                 @relation("ConsumerKhand")
  consumersMandal        Consumer[]                 @relation("ConsumerMandal")
  consumersGram          Consumer[]                 @relation("ConsumerGram")
  createdAt              DateTime                   @default(now()) @map("created_at")
  updatedAt              DateTime                   @updatedAt @map("updated_at")

  @@unique([parentId, name])
  @@index([level])
  @@index([parentId])
  @@map("hierarchy_node")
}

// ─── Jagrut Malwa: Designation Module ─────────────────────────────────────────

model UserHierarchyDesignation {
  id            Int                  @id @default(autoincrement())
  user          Admin                @relation("UserAssignments", fields: [userId], references: [id], onDelete: Restrict)
  userId        Int                  @map("user_id")
  node          HierarchyNode        @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  nodeId        Int                  @map("node_id")
  designation   HierarchyDesignation @relation(fields: [designationId], references: [id], onDelete: Restrict)
  designationId Int                  @map("designation_id")
  reportingTo   Admin?               @relation("ReportingManager", fields: [reportingId], references: [id], onDelete: SetNull)
  reportingId   Int?                 @map("reporting_id")
  assignedAt    DateTime             @default(now()) @map("assigned_at")
  unassignedAt  DateTime?            @map("unassigned_at")
  isActive      Boolean              @default(true) @map("is_active")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  @@index([userId])
  @@index([nodeId])
  @@index([designationId])
  @@index([reportingId])
  @@index([isActive])
  @@index([nodeId, designationId, isActive])
  @@map("user_hierarchy_designation")
}

// ─── Jagrut Malwa: Publish Issue Module ───────────────────────────────────────

enum PublishIssueStatus {
  Draft     @map("draft")
  Published @map("published")
  Archived  @map("archived")

  @@map("publish_issue_status")
}

model PublishIssue {
  id            Int                @id @default(autoincrement())
  issueNo       String             @unique @map("issue_no")
  title         String             @default("")
  publishDate   DateTime           @map("publish_date")
  totalCopies   Int                @map("total_copies")
  filePath      String?            @map("file_path")
  status        PublishIssueStatus @default(Draft)
  publishedBy   Admin?             @relation("PublishedIssues", fields: [publishedById], references: [id], onDelete: SetNull)
  publishedById Int?               @map("published_by_id")
  dispatches    DispatchEntry[]
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  @@index([status])
  @@index([publishDate])
  @@index([publishedById])
  @@map("publish_issue")
}

// ─── Jagrut Malwa: Dispatch Module ────────────────────────────────────────────

enum DispatchStatus {
  Draft       @map("draft")
  Dispatched  @map("dispatched")
  InTransit   @map("in_transit")
  Received    @map("received")
  Discrepancy @map("discrepancy")
  Forwarded   @map("forwarded")
  Completed   @map("completed")
  Cancelled   @map("cancelled")

  @@map("dispatch_status")
}

model DispatchEntry {
  id               Int            @id @default(autoincrement())
  issue            PublishIssue   @relation(fields: [issueId], references: [id], onDelete: Restrict)
  issueId          Int            @map("issue_id")
  fromPoint        HierarchyNode? @relation("DispatchesFrom", fields: [fromPointId], references: [id], onDelete: Restrict)
  fromPointId      Int?           @map("from_point_id")
  toPoint          HierarchyNode  @relation("DispatchesTo", fields: [toPointId], references: [id], onDelete: Restrict)
  toPointId        Int            @map("to_point_id")
  quantity         Int
  dispatchDate     DateTime       @default(now()) @map("dispatch_date")
  trackingLink     String?        @map("tracking_link")
  status           DispatchStatus @default(Dispatched)
  receivedQuantity Int?           @map("received_quantity")
  receivedAt       DateTime?      @map("received_at")
  receivedBy       Admin?         @relation("DispatchesReceived", fields: [receivedById], references: [id], onDelete: Restrict)
  receivedById     Int?           @map("received_by_id")
  dispatchedBy     Admin?         @relation("DispatchesCreated", fields: [dispatchedById], references: [id], onDelete: Restrict)
  dispatchedById   Int?           @map("dispatched_by_id")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@index([issueId])
  @@index([fromPointId])
  @@index([toPointId])
  @@index([status])
  @@index([dispatchDate])
  @@index([receivedById])
  @@index([dispatchedById])
  @@map("dispatch_entry")
}

// ─── Jagrut Malwa: Consumer Module ───────────────────────────────────────────

enum ConsumerStatus {
  Active   @map("active")
  InActive @map("inactive")

  @@map("consumer_status")
}

model Consumer {
  id               Int            @id @default(autoincrement())
  fullName         String         @map("full_name")
  fatherName       String         @map("father_name")
  whatsappMobile   String         @unique @map("whatsapp_mobile")
  additionalMobile String?        @map("additional_mobile")
  fullAddress      String         @map("full_address")
  postalGram       String?        @map("postal_gram")
  post             String?        @map("post")
  tehsil           String?        @map("tehsil")
  pincode          String?        @map("pincode")
  jila             HierarchyNode  @relation("ConsumerJila", fields: [jilaId], references: [id], onDelete: Restrict)
  jilaId           Int            @map("jila_id")
  khand            HierarchyNode  @relation("ConsumerKhand", fields: [khandId], references: [id], onDelete: Restrict)
  khandId          Int            @map("khand_id")
  mandal           HierarchyNode  @relation("ConsumerMandal", fields: [mandalId], references: [id], onDelete: Restrict)
  mandalId         Int            @map("mandal_id")
  gram             HierarchyNode  @relation("ConsumerGram", fields: [gramId], references: [id], onDelete: Restrict)
  gramId           Int            @map("gram_id")
  registrarName    String         @map("registrar_name")
  registrarMobile  String         @map("registrar_mobile")
  registeredBy     User?          @relation("RegisteredConsumers", fields: [registeredById], references: [id], onDelete: SetNull)
  registeredById   Int?           @map("registered_by_id")
  status           ConsumerStatus @default(Active)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@index([whatsappMobile])
  @@index([jilaId])
  @@index([khandId])
  @@index([mandalId])
  @@index([gramId])
  @@index([registeredById])
  @@index([status])
  @@map("consumer")
}
