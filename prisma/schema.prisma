// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

enum AdminStatus {
  Active  @map("active")
  Blocked @map("blocked")

  @@map("admin_status")
}

model HierarchyDesignation {
  id          Int                        @id @default(autoincrement())
  name        String
  level       HierarchyLevel
  status      HierarchyStatus            @default(Active)
  description String                     @default("")
  assignments UserHierarchyDesignation[]
  createdAt   DateTime                   @default(now()) @map("created_at")
  updatedAt   DateTime                   @updatedAt @map("updated_at")

  @@unique([level, name])
  @@index([level])
  @@index([status])
  @@map("hierarchy_designation")
}

model Admin {
  id                     Int                        @id @default(autoincrement())
  firstname              String
  lastname               String
  email                  String                     @unique
  mobile                 String?                    @unique
  profileImage           String?                    @map("profile_image")
  status                 AdminStatus                @default(Active)
  createdAt              DateTime                   @default(now()) @map("created_at")
  updatedAt              DateTime                   @updatedAt @map("updated_at")
  meta                   AdminMeta?
  role                   Role                       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  roleId                 Int                        @map("role_id")
  receivedDispatches     DispatchEntry[]            @relation("DispatchesReceived")
  createdDispatches      DispatchEntry[]            @relation("DispatchesCreated")
  designationAssignments UserHierarchyDesignation[] @relation("UserAssignments")
  subordinateAssignments UserHierarchyDesignation[] @relation("ReportingManager")
  publishedIssues        PublishIssue[]             @relation("PublishedIssues")
  registeredUsers        User[]                     @relation("RegisteredUsers")
  deliveredParcels       DeliveryLog[]              @relation("DeliveryLogsDelivered")

  @@map("admin")
}

model AdminMeta {
  passwordSalt String? @map("password_salt")
  passwordHash String? @map("password_hash")
  admin        Admin   @relation(fields: [adminId], references: [id])
  adminId      Int     @unique() @map("admin_id")

  @@map("admin_meta")
}

// ─── User (app user / account) ────────────────────────────────────────────────

enum UserStatus {
  Active  @map("active")
  Blocked @map("blocked")

  @@map("user_status")
}

model User {
  id               Int           @id @default(autoincrement())
  fullName         String        @map("full_name")
  fatherName       String        @map("father_name")
  whatsappMobile   String        @unique @map("whatsapp_mobile")
  additionalMobile String?       @map("additional_mobile")
  fullAddress      String        @map("full_address")
  postalGram       String?       @map("postal_gram")
  post             String?       @map("post")
  tehsil           String?       @map("tehsil")
  pincode          String?       @map("pincode")
  vibhag           HierarchyNode @relation("UserVibhag", fields: [vibhagId], references: [id], onDelete: Restrict)
  vibhagId         Int           @map("vibhag_id")
  jila             HierarchyNode @relation("UserJila", fields: [jilaId], references: [id], onDelete: Restrict)
  jilaId           Int           @map("jila_id")
  khand            HierarchyNode @relation("UserKhand", fields: [khandId], references: [id], onDelete: Restrict)
  khandId          Int           @map("khand_id")
  mandal           HierarchyNode @relation("UserMandal", fields: [mandalId], references: [id], onDelete: Restrict)
  mandalId         Int           @map("mandal_id")
  gram             HierarchyNode @relation("UserGram", fields: [gramId], references: [id], onDelete: Restrict)
  gramId           Int           @map("gram_id")
  registrarName    String        @map("registrar_name")
  registrarMobile  String        @map("registrar_mobile")
  registeredBy     Admin?        @relation("RegisteredUsers", fields: [registeredById], references: [id], onDelete: SetNull)
  registeredById   Int?          @map("registered_by_id")
  status           UserStatus    @default(Active)

  subscriptions Subscription[]
  deliveryLogs  DeliveryLog[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  settings      UserSetting[]

  @@index([whatsappMobile])
  @@index([vibhagId])
  @@index([jilaId])
  @@index([khandId])
  @@index([mandalId])
  @@index([gramId])
  @@index([registeredById])
  @@index([status])
  @@map("user")
}

